<?xml version="1.0" encoding="utf-8"?>
<!-- Same gradient for v21+ (API 21+) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF6B9D"
                android:endColor="#C44569"
                android:angle="135"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="96dp" android:height="96dp"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="72dp"
        android:height="72dp">
        <shape android:shape="oval">
            <solid android:color="#FF6B9D"/>
            <size android:width="72dp" android:height="72dp"/>
        </shape>
    </item>
</layer-list>